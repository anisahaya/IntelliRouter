{
  "name": "model-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "model-router": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.workspace.ts",
    "smoke": "node scripts/smoke.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "postman": "node scripts/postman-smoke.mjs",
    "validate:skill": "UV_CACHE_DIR=${TMPDIR:-/tmp}/model-router-uv-cache uv run --with pyyaml python ${CODEX_HOME:-$HOME/.codex}/skills/.system/skill-creator/scripts/quick_validate.py skills/intelligent-model-router",
    "validate:plugin": "UV_CACHE_DIR=${TMPDIR:-/tmp}/model-router-uv-cache uv run --with pyyaml python ${CODEX_HOME:-$HOME/.codex}/skills/.system/plugin-creator/scripts/validate_plugin.py .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm postman && pnpm mcp:smoke && pnpm validate:skill && pnpm validate:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "better-sqlite3": "^12.5.0",
    "commander": "^14.0.2",
    "fastify": "^5.6.2",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "newman": "^6.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
